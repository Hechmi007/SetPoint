# Copy to .env for local dev. On Netlify, set the same keys in Site configuration → Environment variables.
# Never commit .env (it is git-ignored).

# MongoDB Atlas connection string. Leave empty locally to use a JSON file in .data/
MONGODB_URI=
MONGODB_DB=setpoint

# Admin access — generate all three with:  npm run admin-setup
ADMIN_PATH=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# ---- Order notifications (each channel is optional; see README "Notifications") ----
# Your site's address, used in tracking links (Netlify fills this in automatically when left empty)
SITE_URL=

# 1) E-mail to you — resend.com (free). NOTIFY_EMAIL = the address you signed up to Resend with.
RESEND_API_KEY=
NOTIFY_EMAIL=

# 2) Telegram to you — free official bot, with a one-tap button to confirm to the customer on WhatsApp
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (optional) WhatsApp to you — callmebot.com, when it has free slots. OWNER_WHATSAPP = digits only, with country code.
OWNER_WHATSAPP=
CALLMEBOT_APIKEY=

# 3) WhatsApp to the customer — official WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_CLIENT=commande_recue
WHATSAPP_TEMPLATE_LANG=fr
