# Copy to .env for local dev. On Netlify, set the same keys in Site configuration → Environment variables.
# Never commit .env (it is git-ignored).

# MongoDB Atlas connection string. Leave empty locally to use a JSON file in .data/
MONGODB_URI=
MONGODB_DB=setpoint

# Admin access — generate all three with:  npm run admin-setup
ADMIN_PATH=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=
